{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ReverseProxy": {
        "Routes": {

            "auth-route": {
                "ClusterId": "auth-cluster",
                "Match": {
                    "Path": "/api/auth/{**catch-all}"
                }
            },

            "doctors-route": {
                "ClusterId": "doctors-cluster",
                "Match": {
                    "Path": "/api/doctors/{**catch-all}"
                }
            },

            "patients-route": {
                "ClusterId": "patients-cluster",
                "Match": {
                    "Path": "/api/patients/{**catch-all}"
                }
            },

            "appointments-route": {
                "ClusterId": "appointments-cluster",
                "Match": {
                    "Path": "/api/appointments/{**catch-all}"
                }
            },

            "medical-records-route": {
                "ClusterId": "medical-records-cluster",
                "Match": {
                    "Path": "/api/medical-records/{**catch-all}"
                }
            }

        },

        "Clusters": {

            "auth-cluster": {
                "HttpRequest": {
                    "Version": "1.1",
                    "VersionPolicy": "RequestVersionExact"
                },
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7248/"
                    }
                }
            },

            "doctors-cluster": {
                "HttpRequest": {
                    "Version": "1.1",
                    "VersionPolicy": "RequestVersionExact"
                },
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7098/"
                    }
                }
            },

            "patients-cluster": {
                "HttpRequest": {
                    "Version": "1.1",
                    "VersionPolicy": "RequestVersionExact"
                },
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7187/"
                    }
                }
            },

            "appointments-cluster": {
                "HttpRequest": {
                    "Version": "1.1",
                    "VersionPolicy": "RequestVersionExact"
                },
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7283/"
                    }
                }
            },

            "medical-records-cluster": {
                "HttpRequest": {
                    "Version": "1.1",
                    "VersionPolicy": "RequestVersionExact"
                },
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7280/"
                    }
                }
            }

        }
    }
}